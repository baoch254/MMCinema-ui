{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "mmcinema-app",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "yarn nx dev mobile",
    "beforeBuildCommand": "yarn nx dev mobile"
  },
  "app": {
    "windows": [
      {
        "title": "mmcinema-app",
        "width": 576,
        "height": 600,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
