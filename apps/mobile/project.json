{
  "name": "mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/mobile",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project mobile --web",
  "targets": {
    "tauri:dev": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["npx tauri dev"],
        "parallel": true,
        "cwd": "apps/mobile"
      }
    },
    "tauri:build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["npx tauri build"],
        "cwd": "apps/mobile"
      }
    }
  }
}
